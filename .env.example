# Server-side secrets. Set these as Supabase secrets, never in the Android app.
#   supabase secrets set --env-file supabase/functions/.env
LLM_PROVIDER=openai            # openai | deepseek
LLM_MODEL=                     # required, e.g. the model name your provider gives you
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DEFAULT_TIMEZONE=Asia/Jakarta
