# Server-side secrets. Set these as Supabase secrets, never in the Android app.
# Copy to supabase/functions/.env, fill in, then:
#   supabase secrets set --env-file supabase/functions/.env
# Keep comments on their own lines (no "VALUE  # comment").

# Ordered fallback chain (ADR-016): openrouter | deepseek | openai, comma-separated.
# A provider without its key/model is skipped. (Legacy: LLM_PROVIDER=<one name>.)
LLM_PROVIDERS=openrouter,deepseek
OPENROUTER_API_KEY=
# First = primary model, the rest = OpenRouter-side fallbacks. ":free" models cost $0 (50 requests/day).
OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-super-120b-a12b:free
# Model for deepseek/openai, e.g. deepseek-flash
LLM_MODEL=deepseek-flash
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DEFAULT_TIMEZONE=Asia/Jakarta
